# Copy to .env next to docker-compose.yaml, then `docker compose up -d`.
# Secrets (database, message broker, JWT, internal certificates) are generated on first
# start and are not set here. Every setting below is optional unless marked required.

# Required: the deployment release this .env is for. A release's env.example sets it; to
# upgrade, put the new release's docker-compose.yaml in place, set its version here, then
# `docker compose up -d`. The stack does not start when this and the Compose file disagree.
CODECLARITY_VERSION=

# Required: the name the instance is reached at. It picks the certificate: localhost uses
# Caddy's internal CA, a public name gets one automatically from Let's Encrypt or ZeroSSL
# (ports 80 and 443 reachable from the internet, DNS pointing here).
DOMAIN=localhost

# Your own certificate (full chain) and private key, as PEM in double quotes; both or neither.
# When set, Caddy serves them instead of getting a certificate. Run `docker compose up -d` after a change.
# TLS_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
# TLS_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"

# ACME directory for automatic certificates, e.g. Let's Encrypt staging to test a public DOMAIN:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Published ports, when 80 or 443 is taken on this host. Leave HTTPS_PORT unset for 443:
# when set, links in emails, OAuth callbacks and the HTTP redirect use https://DOMAIN:HTTPS_PORT.
# A public DOMAIN with automatic certificates still needs 80 and 443 reachable from the internet.
# HTTP_PORT=8080
# HTTPS_PORT=8443
# HTTP3_PORT=8443

# NVD API key: faster knowledge updates. The knowledge daemon runs without one, at NVD's lower rate.
NVD_API_KEY=
# Vulnerability-Lookup (GCVE) API key.
VULNERABILITY_LOOKUP_API_KEY=

# Defaults for `docker compose run --rm api create-user`; flags override them. Pass the
# password with --password or `-e CREATE_USER_PASSWORD`, not here.
CREATE_USER_EMAIL=
CREATE_USER_NAME=

# Mail server, for signup confirmation and password reset emails. Login works without one.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_AUTH_USER=noreply@example.com
# MAIL_AUTH_PASSWORD=
# MAIL_DEFAULT_FROM=noreply@example.com

# OAuth apps for GitHub and GitLab sign-in and integrations; each is off until set.
# GITHUB_AUTH_CLIENT_ID=
# GITHUB_AUTH_CLIENT_SECRET=
# GITLAB_AUTH_CLIENT_ID=
# GITLAB_AUTH_CLIENT_SECRET=
# GITLAB_AUTH_HOST=https://gitlab.com
# CLICKUP_CLIENT_ID=
# CLICKUP_CLIENT_SECRET=

# Optional components, comma separated. monitoring: Prometheus, Grafana and the Postgres exporter.
# COMPOSE_PROFILES=monitoring

# Grafana admin user, with monitoring on; its password is generated (see README).
# GRAFANA_USER=admin
