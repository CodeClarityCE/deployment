# AMQP
AMQP_ANALYSES_QUEUE=api_request
# TLS-only: RabbitMQ accepts encrypted connections on 5671; plaintext is disabled.
AMQP_PROTOCOL=amqps
AMQP_HOST=rabbitmq
AMQP_PORT=5671
# Verify the server cert against the shared CA (same ca.crt as PostgreSQL).
AMQP_SSLMODE=verify-ca
AMQP_SSLROOTCERT=/var/lib/postgresql/certs/ca.crt
# Please change the user and password
AMQP_USER=guest # Create a new user in the RabbitMQ management console
AMQP_PASSWORD=guest # and change the values here
