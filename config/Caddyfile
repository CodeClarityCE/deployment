# DOMAIN picks the certificate: Caddy's internal CA for localhost, ACME for a public name.
# CADDY_TLS, CADDY_ACME_CA and CADDY_HTTPS_PORT are set by the Compose file from .env.
{
	{$CADDY_ACME_CA}
	# The redirect below replaces Caddy's own, which always points at port 443.
	auto_https disable_redirects
}

# HTTP to HTTPS on the published HTTPS port. ACME HTTP challenges are still answered here.
http://{$DOMAIN} {
	redir https://{host}{$CADDY_HTTPS_PORT}{uri} permanent
}

(tls) {
	{$CADDY_TLS}
}

{$DOMAIN} {
	import tls
	log
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	root * /srv/app/dist

	# A missing chunk stays a 404, so the app reloads a stale page instead of parsing HTML.
	handle /assets/* {
		file_server
	}

	# Any other path is a built file, or the app's index page and the Vue router picks the route.
	handle {
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN}:15672 {
	import tls
	reverse_proxy rabbitmq:15672
}

# Prometheus and Grafana run only with the monitoring profile; without it, say so instead of a 502.
(monitoring-off) {
	handle_errors 502 {
		respond "{args[0]} is not running. It is part of the optional monitoring profile: set COMPOSE_PROFILES=monitoring in .env, then run docker compose up -d." 503
	}
}

{$DOMAIN}:9091 {
	import tls
	log
	reverse_proxy prometheus:9090
	import monitoring-off Prometheus
}

{$DOMAIN}:3001 {
	import tls
	log
	reverse_proxy grafana:3000
	import monitoring-off Grafana
}

# Metrics endpoint for monitoring
:2019 {
	metrics /metrics
}
