# DOMAIN picks the certificate: Caddy's internal CA for localhost, ACME for a public name.
# CADDY_TLS and CADDY_ACME_CA are set by the Compose file from TLS_CERT and ACME_CA in .env.
{
	{$CADDY_ACME_CA}
}

(tls) {
	{$CADDY_TLS}
}

{$DOMAIN} {
	import tls

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	log

	root * /srv/app/dist

	rewrite /results* /
	rewrite /projects* /
	rewrite /analyses* /
	rewrite /login* /
	rewrite /help* /
	rewrite /orgs* /
	rewrite /org* /
	rewrite /signup* /
	rewrite /password_reset_request* /
	rewrite /email_action* /
	rewrite /settings* /
	rewrite /auth* /
	rewrite /404* /

	encode zstd gzip
	file_server
}

{$DOMAIN}:15672 {
	import tls
	reverse_proxy rabbitmq:15672
}

{$DOMAIN}:9091 {
	import tls
	log
	reverse_proxy prometheus:9090
}

{$DOMAIN}:3001 {
	import tls
	log
	reverse_proxy grafana:3000
}

# Metrics endpoint for monitoring
:2019 {
	metrics /metrics
}
