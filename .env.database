# PG CONF
POSTGRES_PASSWORD="!ChangeMe!"
# PGDATA defaults to /var/lib/postgresql/18/docker in PostgreSQL 18

# PGBOUNCER CONF
# Most pooler config lives in ./config/pgbouncer.ini. PGBOUNCER_AUTH_PASSWORD is the
# password for the dedicated "pgbouncer_auth" role (created by the init script and used
# for auth_query). KEEP IT IN SYNC with the entry in ./config/userlist.txt.
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_AUTH_PASSWORD="!ChangeMe!!"

# Application role passwords (used by init script to create roles)
CC_API_PASSWORD="!ChangeMe!!"
CC_SERVICE_PASSWORD="!ChangeMe!!"
CC_PLUGIN_PASSWORD="!ChangeMe!!"
CC_KNOWLEDGE_PASSWORD="!ChangeMe!!"
CC_EXPORTER_PASSWORD="!ChangeMe!!"

# Connection pool bounds (per service/plugin instance, env-overridable).
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_SECONDS=60
# API (NestJS / pg) pool bound per DataSource.
PG_DB_POOL_MAX=10

# Default database connection (overridden per-service in .env.api, .env.codeclarity, etc.)
# NOTE: Docker Compose env_file does NOT interpolate ${VAR} references — use literal values.
# Services connect through the pooler. Requires certs regenerated with the "pgbouncer" SAN
# (make setup-pg-certs). Migrations (TypeORM, transactional) are pooling-safe; if a migration
# ever needs a direct connection, run it against db:5432 instead.
PG_DB_USER="cc_api"
PG_DB_PASSWORD="!ChangeMe!!"
PG_DB_HOST="pgbouncer"
PG_DB_PORT="6432"
PG_DB_NAME="codeclarity"
PG_DB_SSLMODE="verify-ca"
PG_DB_SSLROOTCERT="/var/lib/postgresql/certs/ca.crt"

# Admin credentials (for database creation/migration only)
PG_DB_ADMIN_USER="postgres"
PG_DB_ADMIN_PASSWORD="!ChangeMe!"

# Postgres Exporter
DATA_SOURCE_NAME="postgresql://cc_exporter:!ChangeMe!!@db:5432/codeclarity?sslmode=verify-ca&sslrootcert=/var/lib/postgresql/certs/ca.crt"
